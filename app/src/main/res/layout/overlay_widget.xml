<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay"
    android:padding="8dp"
    android:minWidth="118dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/overlayLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="عتاد"
            android:textColor="@color/accent_gold"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayCloseBtn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:text="✕"
            android:textColor="@color/text_sub_dark"
            android:textSize="9sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="@color/text_main_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/overlayTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="00:00:00"
        android:textColor="@color/accent_gold"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

</LinearLayout>
