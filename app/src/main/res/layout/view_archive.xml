<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦 أرشيف العربات المحذوفة والمكتملة"
        android:textColor="@color/text_main_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnClearArchive"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_option_off"
        android:text="🗑️ مسح الأرشيف"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:paddingHorizontal="16dp" />

    <TextView
        android:id="@+id/emptyArchiveMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_archive"
        android:textColor="@color/text_sub_dark"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="30dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/archiveRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />

</LinearLayout>
